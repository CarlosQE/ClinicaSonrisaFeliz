@host = http://localhost:5087
@especialidadGeneral = 10000000-0000-0000-0000-000000000001
@odontologo = 20000000-0000-0000-0000-000000000001

### Listar especialidades
GET {{host}}/api/Especialidad
Accept: application/json

### Obtener una especialidad
GET {{host}}/api/Especialidad/{{especialidadGeneral}}
Accept: application/json

### Registrar especialidad
POST {{host}}/api/Especialidad
Content-Type: application/json

{
  "nombre": "Periodoncia",
  "descripcion": "Tratamiento de encías"
}

### Actualizar especialidad
PUT {{host}}/api/Especialidad/{{especialidadGeneral}}
Content-Type: application/json

{
  "nombre": "Odontología General",
  "descripcion": "Revisión, limpieza y tratamientos básicos"
}

### Eliminar especialidad
DELETE {{host}}/api/Especialidad/{{especialidadGeneral}}

### Listar horarios de un odontólogo
GET {{host}}/api/HorarioOdontologo/odontologo/{{odontologo}}
Accept: application/json

### Obtener un horario (reemplazar por un id real)
GET {{host}}/api/HorarioOdontologo/40000000-0000-0000-0000-000000000001
Accept: application/json

### Registrar horario
POST {{host}}/api/HorarioOdontologo/odontologo/{{odontologo}}
Content-Type: application/json

{
  "diaSemana": 1,
  "horaInicio": "08:00:00",
  "horaFin": "12:00:00"
}

### Actualizar horario (reemplazar por un id real)
PUT {{host}}/api/HorarioOdontologo/40000000-0000-0000-0000-000000000001
Content-Type: application/json

{
  "diaSemana": 1,
  "horaInicio": "08:00:00",
  "horaFin": "11:00:00"
}

### Eliminar horario (reemplazar por un id real)
DELETE {{host}}/api/HorarioOdontologo/40000000-0000-0000-0000-000000000001
