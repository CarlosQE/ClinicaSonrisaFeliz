@* Sugiere horarios libres de un odontólogo en un día (según sus franjas y su agenda). La API valida al guardar. *@
@inject ClienteApi Api
@inject TimeProvider Reloj

<div class="tarjeta">
    <h2><span class="ms me-1">schedule</span>Horarios libres</h2>
    @if (IdOdontologo is null || Fecha is null)
    {
        <p class="small text-muted mb-0">Elige odontólogo y fecha para ver las horas disponibles.</p>
    }
    else if (_cargando)
    {
        <p class="small text-muted mb-3">Buscando horarios…</p>
        <div class="d-flex flex-wrap gap-2" aria-busy="true">
            @for (var i = 0; i < 8; i++)
            {
                <span class="esqueleto-bloque" style="width:68px;height:36px;border-radius:8px"></span>
            }
        </div>
    }
    else if (_libres.Count == 0)
    {
        <p class="small text-muted mb-0">Sin horarios libres el @Formato.FechaLarga(Fecha.Value).</p>
    }
    else
    {
        <p class="small text-muted mb-3">@Formato.FechaLarga(Fecha.Value) · toca una hora para usarla.</p>
        <div class="d-flex flex-wrap gap-2 horarios-chips">
            @foreach (var h in _libres)
            {
                <button type="button" class="chip-filtro @(Seleccionado == h ? "activo" : "")" @onclick="() => AlElegir.InvokeAsync(h)">@Formato.Hora(h)</button>
            }
        </div>
    }
</div>

@code {
    [Parameter] public Guid? IdOdontologo { get; set; }
    [Parameter] public DateOnly? Fecha { get; set; }
    [Parameter] public int Duracion { get; set; } = 30;
    [Parameter] public Guid? Excluir { get; set; }
    [Parameter] public TimeOnly? Seleccionado { get; set; }
    [Parameter] public EventCallback<TimeOnly> AlElegir { get; set; }

    private List<TimeOnly> _libres = new();
    private bool _cargando;
    private string? _ultimaClave;

    protected override async Task OnParametersSetAsync()
    {
        if (IdOdontologo is null || Fecha is null) return;
        var clave = $"{IdOdontologo}|{Fecha}|{Duracion}";
        if (clave == _ultimaClave) return;
        _ultimaClave = clave;

        _cargando = true;
        var horarios = Api.GetAsync<List<HorarioRespuesta>>($"api/HorarioOdontologo/odontologo/{IdOdontologo}");
        var agenda = Api.GetAsync<List<CitaRespuesta>>($"api/Cita/agenda?fecha={Fecha:yyyy-MM-dd}&idOdontologo={IdOdontologo}");
        await Task.WhenAll(horarios, agenda);
        _libres = horarios.Result.Exito && agenda.Result.Exito
            ? Disponibilidad.HorariosLibres(Fecha.Value, Duracion, Reloj.GetLocalNow().DateTime,
                horarios.Result.Datos ?? new(), agenda.Result.Datos ?? new(), Excluir)
            : new();
        _cargando = false;
    }
}
