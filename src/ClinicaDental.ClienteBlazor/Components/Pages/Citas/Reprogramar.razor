@page "/citas/{Id:guid}/reprogramar"

<AvisoError Mensaje="@MensajeError" SinConexion="SinConexion" />

@if (Cargando)
{
    <Cargando Filas="3" />
}
else if (_cita is { } c)
{
    <Encabezado Titulo="Reprogramar cita" Subtitulo="@($"{c.Paciente?.NombreCompleto} · actualmente el {Formato.FechaHora(c.Fecha, c.Hora)}")">
        <Migas><a href="citas">Citas</a><span class="ms">chevron_right</span><a href="citas/@c.Id">Detalle</a></Migas>
    </Encabezado>

    <div class="row g-4">
        <div class="col-xl-7">
            <EditForm Model="_datos" OnValidSubmit="Guardar" class="formulario" FormName="reprogramar">
                <DataAnnotationsValidator />
                <AvisoError Mensaje="@ErrorFormulario" />
                <div class="form-floating mb-3">
                    <InputSelect id="odontologo" class="form-select" @bind-Value="_datos.IdNuevoOdontologo">
                        @foreach (var o in _odontologos)
                        {
                            <option value="@o.Id">@o.NombreCompleto · @o.Especialidad?.Nombre</option>
                        }
                    </InputSelect>
                    <label for="odontologo">Odontólogo</label>
                    <div class="ayuda">Puedes mantener al mismo odontólogo o asignar otro.</div>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-7 form-floating">
                        <InputDate id="nueva-fecha" class="form-control" @bind-Value="_datos.NuevaFecha" />
                        <label for="nueva-fecha">Nueva fecha *</label>
                        <ValidationMessage For="() => _datos.NuevaFecha" />
                    </div>
                    <div class="col-md-5 form-floating">
                        <InputDate Type="InputDateType.Time" id="nueva-hora" class="form-control" @bind-Value="_datos.NuevaHora" />
                        <label for="nueva-hora">Nueva hora *</label>
                        <ValidationMessage For="() => _datos.NuevaHora" />
                    </div>
                    <div class="col-12"><div class="ayuda">Se mantiene la duración de @c.DuracionMinutos minutos.</div></div>
                </div>
                <div class="formulario-acciones">
                    <a class="btn btn-text" href="citas/@c.Id">Volver</a>
                    <BotonEnviar Enviando="Enviando" Texto="Reprogramar" Icono="update" />
                </div>
            </EditForm>
        </div>
        <div class="col-xl-5">
            <HorariosLibres IdOdontologo="_datos.IdNuevoOdontologo" Fecha="_datos.NuevaFecha"
                            Duracion="c.DuracionMinutos" Excluir="c.Id" Seleccionado="_datos.NuevaHora" AlElegir="h => _datos.NuevaHora = h" />
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private CitaRespuesta? _cita;
    private ReprogramarCitaDto _datos = new();
    private List<OdontologoRespuesta> _odontologos = new();

    protected override async Task OnParametersSetAsync()
    {
        LimpiarErrores();
        Cargando = true;
        var r = await Api.GetAsync<CitaRespuesta>($"api/Cita/{Id}");
        _cita = r.Datos;
        if (!r.Exito || _cita is null)
        {
            RegistrarError(r);
            if (r.NoEncontrado) MensajeError = "La cita no existe.";
        }
        else if (!_cita.EstaVigente)
        {
            Notificar.Error($"No se puede reprogramar una cita {Formato.Texto(_cita.Estado).ToLowerInvariant()}.");
            Nav.NavigateTo($"citas/{Id}");
            return;
        }
        else
        {
            _datos = new ReprogramarCitaDto { NuevaFecha = _cita.Fecha, NuevaHora = _cita.Hora, IdNuevoOdontologo = _cita.IdOdontologo };
            _odontologos = await OdontologosAsync();
        }
        Cargando = false;
    }

    private async Task Guardar()
    {
        ErrorFormulario = null;
        Enviando = true;
        var r = await Api.PutAsync<CitaRespuesta>($"api/Cita/{Id}/reprogramar", _datos);
        Enviando = false;
        if (!r.Exito)
        {
            ErrorFormulario = r.Mensaje;
            return;
        }
        Notificar.Exito($"Cita reprogramada para el {Formato.FechaHora(_datos.NuevaFecha!.Value, _datos.NuevaHora!.Value)}.");
        Nav.NavigateTo($"citas/{Id}");
    }
}
