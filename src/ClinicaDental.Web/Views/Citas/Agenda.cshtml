@model AgendaDiariaViewModel
@{
    ViewData["Title"] = "Agenda diaria";
    var formato = "yyyy-MM-dd";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="h3 mb-0">Agenda del @Model.Fecha.ToString("dddd dd/MM/yyyy")</h1>
    <a class="btn btn-success" asp-action="Create">+ Agendar cita</a>
</div>

<form method="get" asp-action="Agenda" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <a class="btn btn-outline-secondary" asp-action="Agenda"
           asp-route-fecha="@Model.Fecha.AddDays(-1).ToString(formato)" asp-route-odontologoId="@Model.OdontologoId">&laquo; Anterior</a>
    </div>
    <div class="col-auto">
        <label class="form-label" for="fecha">Fecha</label>
        <input class="form-control" type="date" id="fecha" name="fecha" value="@Model.Fecha.ToString(formato)" />
    </div>
    <div class="col-auto">
        <label class="form-label" for="odontologoId">Odontólogo</label>
        <select class="form-select" id="odontologoId" name="odontologoId" asp-items="Model.Odontologos">
            <option value="">Todos</option>
        </select>
    </div>
    <div class="col-auto form-check ms-2 mb-2">
        <input class="form-check-input" type="checkbox" id="incluirCanceladas" name="incluirCanceladas" value="true" @(Model.IncluirCanceladas ? "checked" : "") />
        <label class="form-check-label" for="incluirCanceladas">Incluir canceladas</label>
    </div>
    <div class="col-auto"><button class="btn btn-primary" type="submit">Ver</button></div>
    <div class="col-auto">
        <a class="btn btn-outline-secondary" asp-action="Agenda"
           asp-route-fecha="@Model.Fecha.AddDays(1).ToString(formato)" asp-route-odontologoId="@Model.OdontologoId">Siguiente &raquo;</a>
    </div>
</form>

@if (Model.Citas.Count == 0)
{
    <div class="alert alert-info">No hay citas para este día.</div>
}
else
{
    <table class="table table-hover align-middle" data-testid="tabla-agenda">
        <thead>
            <tr><th>Hora</th><th>Paciente</th><th>Odontólogo</th><th>Motivo</th><th>Estado</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var c in Model.Citas)
        {
            <tr>
                <td class="text-nowrap">@c.FechaHora.ToString("HH:mm") - @c.FechaHoraFin.ToString("HH:mm")</td>
                <td>@c.Paciente?.NombreCompleto</td>
                <td>@c.Odontologo?.NombreCompleto</td>
                <td>@c.Motivo</td>
                <td><partial name="_EstadoCita" model="c.Estado" /></td>
                <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@c.Id">Ver</a></td>
            </tr>
        }
        </tbody>
    </table>
}
