@model CancelarCitaViewModel
@{
    ViewData["Title"] = "Cancelar cita";
}

<h1 class="h3">Cancelar cita #@Model.Id</h1>
<p class="text-muted">
    @Model.Cita?.Paciente?.NombreCompleto — @Model.Cita?.FechaHora.ToString("dd/MM/yyyy HH:mm")
    con @Model.Cita?.Odontologo?.NombreCompleto
</p>

<form asp-action="Cancelar" asp-route-id="@Model.Id" method="post" class="col-lg-6">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="Motivo" class="form-label"></label>
        <textarea asp-for="Motivo" rows="3" class="form-control"></textarea>
        <span asp-validation-for="Motivo" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-danger">Confirmar cancelación</button>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Volver</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
