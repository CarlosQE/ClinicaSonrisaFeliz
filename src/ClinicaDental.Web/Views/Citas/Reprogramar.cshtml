@model ReprogramarCitaViewModel
@{
    ViewData["Title"] = "Reprogramar cita";
}

<h1 class="h3">Reprogramar cita #@Model.Id</h1>
<p class="text-muted">
    @Model.Cita?.Paciente?.NombreCompleto — actualmente el @Model.Cita?.FechaHora.ToString("dd/MM/yyyy HH:mm")
    con @Model.Cita?.Odontologo?.NombreCompleto
</p>

<form asp-action="Reprogramar" asp-route-id="@Model.Id" method="post" class="col-lg-6">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="NuevaFechaHora" class="form-label"></label>
        <input asp-for="NuevaFechaHora" type="datetime-local" step="900" class="form-control" />
        <span asp-validation-for="NuevaFechaHora" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="OdontologoId" class="form-label"></label>
        <select asp-for="OdontologoId" asp-items="Model.Odontologos" class="form-select"></select>
    </div>

    <button type="submit" class="btn btn-warning">Reprogramar</button>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Volver</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
