@{
    ViewData["Title"] = "Inicio";
}

<div class="text-center mb-5">
    <h1 class="display-5">Clínica Dental Sonrisa Feliz</h1>
    <p class="lead text-muted">Sistema de gestión de pacientes, odontólogos, citas, tratamientos y pagos.</p>
</div>

<div class="row row-cols-1 row-cols-md-3 g-4">
    <div class="col">
        <div class="card h-100"><div class="card-body">
            <h5 class="card-title">Pacientes</h5>
            <p class="card-text">Registro, actualización e historial de atención.</p>
            <a class="btn btn-primary" asp-controller="Pacientes" asp-action="Index">Ir a Pacientes</a>
        </div></div>
    </div>
    <div class="col">
        <div class="card h-100"><div class="card-body">
            <h5 class="card-title">Odontólogos</h5>
            <p class="card-text">Especialidades, horarios de trabajo y estado.</p>
            <a class="btn btn-primary" asp-controller="Odontologos" asp-action="Index">Ir a Odontólogos</a>
        </div></div>
    </div>
    <div class="col">
        <div class="card h-100"><div class="card-body">
            <h5 class="card-title">Citas</h5>
            <p class="card-text">Agendar, reprogramar, cancelar y agenda diaria.</p>
            <a class="btn btn-primary" asp-controller="Citas" asp-action="Agenda">Ver agenda de hoy</a>
        </div></div>
    </div>
    <div class="col">
        <div class="card h-100"><div class="card-body">
            <h5 class="card-title">Tratamientos</h5>
            <p class="card-text">Limpieza, ortodoncia, endodoncia, extracciones y observaciones.</p>
            <a class="btn btn-primary" asp-controller="Tratamientos" asp-action="Index">Ir a Tratamientos</a>
        </div></div>
    </div>
    <div class="col">
        <div class="card h-100"><div class="card-body">
            <h5 class="card-title">Pagos</h5>
            <p class="card-text">Registro de pagos, deudas pendientes y comprobantes.</p>
            <a class="btn btn-primary" asp-controller="Pagos" asp-action="Index">Ir a Pagos</a>
        </div></div>
    </div>
</div>
