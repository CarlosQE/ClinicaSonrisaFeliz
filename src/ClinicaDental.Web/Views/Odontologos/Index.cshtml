@model List<Odontologo>
@{
    ViewData["Title"] = "Odontólogos";
}
@* TODO(BagayerosChaco): completar (Nuevo / Editar / Activar-Desactivar / Horarios / Especialidades). *@

<h1 class="h3">Odontólogos</h1>

<table class="table table-hover" data-testid="tabla-odontologos">
    <thead><tr><th>Matrícula</th><th>Nombre</th><th>Especialidad</th><th>Estado</th></tr></thead>
    <tbody>
    @foreach (var o in Model)
    {
        <tr>
            <td>@o.Matricula</td>
            <td>@o.NombreCompleto</td>
            <td>@o.Especialidad?.Nombre</td>
            <td>@(o.Activo ? "Activo" : "Inactivo")</td>
        </tr>
    }
    </tbody>
</table>
