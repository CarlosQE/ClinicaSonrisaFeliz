@model List<Paciente>
@{
    ViewData["Title"] = "Pacientes";
}
@* TODO(ApostolesEvoMorales): completar (botones Nuevo / Editar / Eliminar / Historial). *@

<h1 class="h3">Pacientes</h1>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto"><input class="form-control" name="busqueda" value="@ViewData["Busqueda"]" placeholder="Nombre, apellido o CI" /></div>
    <div class="col-auto"><button class="btn btn-primary" type="submit">Buscar</button></div>
</form>

<table class="table table-hover" data-testid="tabla-pacientes">
    <thead><tr><th>CI</th><th>Apellidos</th><th>Nombres</th><th>Teléfono</th></tr></thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr><td>@p.CI</td><td>@p.Apellidos</td><td>@p.Nombres</td><td>@p.Telefono</td></tr>
    }
    </tbody>
</table>
