@model List<Pago>
@{
    ViewData["Title"] = "Pagos";
}
@* TODO(GuaposMisteriosos): completar (Registrar pago, Deudas, Comprobante). *@

<h1 class="h3">Pagos</h1>

<table class="table table-hover" data-testid="tabla-pagos">
    <thead><tr><th>Comprobante</th><th>Fecha</th><th>Paciente</th><th>Método</th><th class="text-end">Monto (Bs)</th></tr></thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr>
            <td>@p.NumeroComprobante</td>
            <td>@p.FechaPago.ToString("dd/MM/yyyy HH:mm")</td>
            <td>@p.Tratamiento?.Paciente?.NombreCompleto</td>
            <td>@p.Metodo</td>
            <td class="text-end">@p.Monto.ToString("N2")</td>
        </tr>
    }
    </tbody>
</table>
