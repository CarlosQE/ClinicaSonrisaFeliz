@model List<Tratamiento>
@{
    ViewData["Title"] = "Tratamientos";
}
@* TODO(Ultimo): completar (filtros, Nuevo, Detalle, Observaciones, Eliminar). *@

<h1 class="h3">Tratamientos</h1>

<table class="table table-hover" data-testid="tabla-tratamientos">
    <thead><tr><th>Fecha</th><th>Paciente</th><th>Tipo</th><th>Odontólogo</th><th class="text-end">Costo (Bs)</th></tr></thead>
    <tbody>
    @foreach (var t in Model)
    {
        <tr>
            <td>@t.Fecha.ToString("dd/MM/yyyy")</td>
            <td>@t.Paciente?.NombreCompleto</td>
            <td>@t.Tipo</td>
            <td>@t.Odontologo?.NombreCompleto</td>
            <td class="text-end">@t.Costo.ToString("N2")</td>
        </tr>
    }
    </tbody>
</table>
